// Pega esto en Firebase -> Firestore Database -> Reglas -> Publicar.
// Cada usuario solo puede leer y escribir SUS datos, y solo con el correo verificado.
// (El servidor de avisos usa una cuenta de servicio que se salta las reglas.)
// IMPORTANTE: verifica antes tu propio correo en la app (Ajustes -> Cuenta), o dejarás de sincronizar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }
  }
}
