// Pega esto en Firebase -> Firestore Database -> Reglas -> Publicar.
// Cada usuario solo puede leer y escribir SUS datos. (El servidor de avisos usa una cuenta de servicio que se salta las reglas.)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
